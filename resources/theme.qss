QWidget {
    color: #172947;
    font-family: "Segoe UI", "Microsoft YaHei UI", sans-serif;
    font-size: 13px;
}

QMainWindow, QWidget#appRoot {
    background: #f5f8fb;
}

QMainWindow {
    background: #737d87;
}

QWidget#appRoot {
    border: none;
}

QFrame#connectionBar {
    background: #ffffff;
    border: 1px solid #dce7f1;
    border-left: none;
    border-right: none;
}

QFrame#topBar {
    background: #ffffff;
    border-bottom: 1px solid #dfe8f1;
}

QFrame#sideBar {
    background: #fbfdff;
    border-right: 1px solid #dfe8f1;
}

QFrame#bottomBar {
    background: #eef4f9;
    border-top: 1px solid #dfe8f1;
}

QLabel#brandLabel {
    color: #102443;
    font-size: 20px;
    font-weight: 700;
}

QToolButton#windowButton,
QToolButton#closeButton {
    color: #536d89;
    background: transparent;
    border: none;
    border-radius: 4px;
    padding: 0;
    font-family: "Segoe UI", "Microsoft YaHei UI", sans-serif;
    font-size: 16px;
    font-weight: 500;
}

QToolButton#windowButton:hover {
    color: #183452;
    background: #eaf2f8;
}

QToolButton#closeButton:hover {
    color: #c54854;
    background: #fdebed;
}

QToolButton#closeButton:pressed {
    color: #ffffff;
    background: #df5b62;
}

QLabel#pageTitle {
    color: #12294d;
    font-size: 28px;
    font-weight: 700;
}

QLabel#pageSubtitle {
    color: #66809e;
    font-size: 14px;
}

QToolButton#navButton {
    color: #344d6d;
    border: none;
    border-radius: 15px;
    padding: 0;
    min-width: 48px;
    max-width: 60px;
    min-height: 48px;
    max-height: 48px;
}

QToolButton#navButton:hover {
    background: #e8f3ff;
    color: #147de5;
    border: 1px solid #c7e3fb;
}

QToolButton#navButton:checked {
    /* 选中页不抢占悬停激活色，激活底色只跟随当前鼠标位置。 */
    background: transparent;
    color: #344d6d;
    border: 1px solid transparent;
}

QToolButton#navButton:checked:hover {
    background: #e8f3ff;
    color: #0879df;
    border: 1px solid #c7e3fb;
}

QFrame#navTooltip {
    background: #ffffff;
    border: 1px solid #dfe8f1;
    border-radius: 6px;
}

QLabel#navTooltipTitle {
    color: #172947;
    font-size: 14px;
    font-weight: 600;
}

QLabel#navTooltipDescription {
    color: #66809e;
    font-size: 11px;
}

QFrame#card {
    background: #ffffff;
    border: 1px solid #dbe6f0;
    border-radius: 7px;
}

/* 固件文件拖放卡片：拖入可接受文件时用蓝色边框和浅色背景提示。 */
QFrame#firmwareDropZone {
    background: #fbfdff;
    /* 普通态也预留 2px 边框，切换高亮时不会改变卡片内容位置。 */
    border: 2px dashed #cbdceb;
    border-radius: 5px;
}

QFrame#firmwareDropZone[dropActive="true"] {
    background: #eaf4ff;
    border: 2px dashed #1685df;
}

QFrame#cardHeader {
    background: transparent;
    border-bottom: 1px solid #edf2f7;
}

QLabel#cardTitle {
    color: #142a4d;
    font-size: 15px;
    font-weight: 650;
}

QLabel#metricLabel {
    color: #67809e;
    font-size: 12px;
}

QLabel#metricValue {
    color: #12294d;
    font-size: 19px;
    font-weight: 650;
}

QLabel#bodyValue {
    color: #1c3558;
    font-size: 13px;
}

QLabel#mutedLabel {
    color: #7890aa;
}

QLabel#demoBadge {
    color: #4c6684;
    background: #edf3f8;
    border: 1px solid #d7e3ee;
    border-radius: 4px;
    padding: 3px 8px;
    font-size: 11px;
}

QLabel#statusGood {
    color: #07934f;
    background: #e4f7ed;
    border-radius: 4px;
    padding: 3px 8px;
}

QLabel#statusWarn {
    color: #c47b00;
    background: #fff4dc;
    border-radius: 4px;
    padding: 3px 8px;
}

QLabel#statusBad {
    color: #d34242;
    background: #fff0f0;
    border-radius: 4px;
    padding: 3px 8px;
}

QLabel#statusIdle {
    color: #6d829c;
    background: #edf2f7;
    border-radius: 4px;
    padding: 3px 8px;
}

QPushButton {
    color: #244265;
    background: #f8fbfe;
    border: 1px solid #d4e1ed;
    border-radius: 5px;
    padding: 7px 14px;
    min-height: 18px;
}

QPushButton:hover {
    background: #eaf5ff;
    border-color: #5baef1;
}

QPushButton:pressed {
    background: #dceeff;
}

QPushButton#primaryButton {
    color: #ffffff;
    background: #1585e7;
    border-color: #1585e7;
    font-weight: 600;
}

QPushButton#primaryButton:hover {
    background: #0d75d5;
}

QPushButton#dangerButton {
    color: #d63b43;
    background: #fffafa;
    border-color: #ec8e94;
}

QPushButton#softButton {
    background: #eef5fb;
}

QLineEdit, QComboBox, QSpinBox, QDoubleSpinBox {
    color: #1e385c;
    background: #ffffff;
    border: 1px solid #d6e2ed;
    border-radius: 4px;
    padding: 5px 8px;
    min-height: 20px;
}

QComboBox::drop-down {
    border: none;
    width: 24px;
}

QCheckBox {
    spacing: 7px;
    color: #3d5877;
}

QCheckBox::indicator {
    width: 15px;
    height: 15px;
}

QProgressBar {
    background: #e8eef4;
    border: none;
    border-radius: 4px;
    text-align: right;
    color: #ffffff;
}

QProgressBar::chunk {
    background: #2695e9;
    border-radius: 4px;
}

QTableWidget {
    background: #ffffff;
    alternate-background-color: #f8fbfd;
    border: none;
    gridline-color: #e6edf4;
    color: #26415f;
}

QHeaderView::section {
    color: #526b89;
    background: #f7fafd;
    border: none;
    border-bottom: 1px solid #e0e9f2;
    padding: 7px;
    font-weight: 600;
}

QPlainTextEdit {
    color: #5b7390;
    background: #fbfdff;
    border: 1px solid #e2eaf2;
    border-radius: 4px;
    font-family: "Consolas", "Microsoft YaHei UI", monospace;
    font-size: 11px;
}

QTextBrowser {
    color: #5b7390;
    background: #fbfdff;
    border: 1px solid #e2eaf2;
    border-radius: 4px;
    font-family: "Consolas", "Microsoft YaHei UI", monospace;
    font-size: 12px;
}

/* 固件页在缩放显示时提高字号，保证设备信息和命令文字可读。 */
QWidget#firmwarePage {
    font-size: 15px;
}

QWidget#firmwarePage QTableWidget,
QWidget#firmwarePage QComboBox,
QWidget#firmwarePage QPushButton,
QWidget#firmwarePage QHeaderView::section {
    font-size: 14px;
}

QWidget#firmwarePage QTextBrowser {
    font-size: 12px;
}

/* 历史记录独立窗口使用更易阅读的字号。 */
QDialog#historyDialog QLabel {
    font-size: 15px;
}

QDialog#historyDialog QTextBrowser {
    font-size: 14px;
}

QDialog#historyDialog QPushButton {
    min-height: 30px;
    padding: 4px 14px;
    font-size: 14px;
}

/* 高级命令窗口：命令列表、说明和实时监视区使用统一的中文可读字号。 */
QDialog#commandCenter QLabel,
QDialog#commandCenter QListWidget,
QDialog#commandCenter QComboBox,
QDialog#commandCenter QLineEdit,
QDialog#commandCenter QCheckBox,
QDialog#commandCenter QPushButton {
    font-size: 14px;
}

QDialog#commandCenter QTextBrowser {
    font-size: 13px;
}

QScrollArea {
    border: none;
    background: transparent;
}

QScrollArea#motorDebugPageScroll QScrollBar:vertical,
QScrollArea#firmwarePageScroll QScrollBar:vertical {
    width: 10px;
    margin: 2px 1px 2px 1px;
    background: #edf2f7;
    border: none;
    border-radius: 5px;
}

QScrollArea#motorDebugPageScroll QScrollBar::handle:vertical,
QScrollArea#firmwarePageScroll QScrollBar::handle:vertical {
    min-height: 34px;
    background: #a9bacb;
    border-radius: 4px;
}

QScrollArea#motorDebugPageScroll QScrollBar::handle:vertical:hover,
QScrollArea#firmwarePageScroll QScrollBar::handle:vertical:hover {
    background: #7f97ae;
}

QScrollArea#motorDebugPageScroll QScrollBar::add-line:vertical,
QScrollArea#motorDebugPageScroll QScrollBar::sub-line:vertical,
QScrollArea#firmwarePageScroll QScrollBar::add-line:vertical,
QScrollArea#firmwarePageScroll QScrollBar::sub-line:vertical {
    height: 0;
}

QScrollArea#motorDebugPageScroll QScrollBar::add-page:vertical,
QScrollArea#motorDebugPageScroll QScrollBar::sub-page:vertical,
QScrollArea#firmwarePageScroll QScrollBar::add-page:vertical,
QScrollArea#firmwarePageScroll QScrollBar::sub-page:vertical {
    background: transparent;
}

QGraphicsView#pageView {
    border: none;
    background: #f5f8fb;
}

QSlider::groove:horizontal {
    height: 5px;
    background: #e2eaf1;
    border-radius: 2px;
}

QSlider::sub-page:horizontal {
    background: #4aa8ee;
    border-radius: 2px;
}

QSlider::handle:horizontal {
    width: 14px;
    margin: -5px 0;
    border-radius: 7px;
    background: #218fe6;
}
