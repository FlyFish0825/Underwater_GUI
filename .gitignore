# ---------- 本地环境、密钥和个人预设 ----------
.env
.env.*
!.env.example
*.local
*.local.*
secrets/
local-config/
local_config/

# ---------- 本地 SDK / 工具链缓存 ----------
/sdk-local/
/toolchain-local/
/toolchain/
/third_party/_build/
/_deps/

# ---------- 下载缓存和临时解压目录 ----------
/downloads/
/tmp/
