# ============================================================
# ROV Qt 上位机 Git 忽略规则
# 说明：只忽略本地生成物、缓存和个人配置；文档、协议和参考图默认保留。
# ============================================================

# ---------- 操作系统 ----------
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db

# ---------- Qt Creator / Qt 工具 ----------
*.pro.user
*.pro.user.*
*.creator.user
*.qbs.user
.qmake.stash
.qtc_clangd/
.qtc/
**/.qtcreator/
**/.qt/
*.creator

# Qt Creator 本地构建套件和用户会话
*.autosave
*.user

# ---------- CMake / 构建目录 ----------
/build/
/build-*/
/cmake-build-*/
**/CMakeFiles/
**/CMakeCache.txt
**/cmake_install.cmake
**/install_manifest.txt
**/compile_commands.json
**/CTestTestfile.cmake
**/CPackConfig.cmake
**/CPackSourceConfig.cmake
**/Testing/
CMakeUserPresets.json

# CMake 生成的工程文件（公共源码中的 CMakeLists.txt 不会被忽略）
*.cmake.user
*.ninja
*.ninja_deps
*.ninja_log
**/*_autogen/
**/moc_predefs.h
**/qmake.conf

# ---------- qmake / uic / moc / rcc 生成物 ----------
**/Makefile
**/moc_*.cpp
**/moc_*.h
**/qrc_*.cpp
**/ui_*.h
*.moc
*.prl

